pkgname=umbrellascreen
pkgver=@VERSION@
pkgrel=1
pkgdesc='Screenshot overlay and annotation editor for Hyprland'
arch=('x86_64')
url='https://github.com/LeezyWannaFall/UmbrellaScreen'
license=('MIT')
depends=('gtk4' 'gtk4-layer-shell' 'cairo' 'pango' 'glib2' 'graphene' 'glibc' 'gcc-libs' 'grim' 'wl-clipboard' 'hyprland')
makedepends=('rust' 'pkgconf')
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz")

build() {
    cd "$pkgname-$pkgver"
    cargo build --release --locked
}

check() {
    cd "$pkgname-$pkgver"
    cargo fmt --all --check
    cargo clippy --locked --all-targets -- -D warnings
    cargo test --locked
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 target/release/umbrellascreen "$pkgdir/usr/bin/umbrellascreen"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 README.ru.md "$pkgdir/usr/share/doc/$pkgname/README.ru.md"
}
